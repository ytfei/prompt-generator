# ── LLM 配置（待填写；留空时自动回落 mock 模式，不调用真实模型）──
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# ── 模型档位（可选；未配置的档位回落 LLM_MODEL）──
LLM_MODEL_NANO=            # 快档：灵感/草稿等高频操作
LLM_MODEL_MID=             # 中档：日常生成
LLM_MODEL_PRO=             # 强档：复杂创意与深度润色
# ── 存储 ──
DATABASE_URL=sqlite+aiosqlite:///./data/prompt_studio.db
